# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit real credentials.

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required to download gated models (Qwen3-8B).
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# ── Weights & Biases ──────────────────────────────────────────────────────────
# Required for training run logging. Set WANDB_DISABLED=true to skip entirely.
# Get yours at: https://wandb.ai/settings
WANDB_API_KEY=...
WANDB_DISABLED=false

# ── Anthropic (LLM judge, eval only) ─────────────────────────────────────────
# Used by eval/run_interventions.py --llm_judge to run Claude as a held-out
# CoT evaluator (§9.2). Not used during GRPO training.
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Model used for CoT judging.
# claude-haiku-4-5-20251001 is recommended: cheap, fast, sufficient for 1-10 scoring.
# Switch to claude-sonnet-4-6 if you want higher quality judgements for final evals.
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5-20251001
